                "name": "x-fapi-auth-date",
                "value": ""
              },
              {
                "name": "x-fapi-customer-ip-address",
                "value": ""
              },
              {
                "name": "x-fapi-interaction-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "x-customer-user-agent",
                "value": ""
              },
              {
                "name": "x-client-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "AccountId",
                "value": "",
                "type": "path",
                "description": "AccountId"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://authserver.example/authorization",
              "accessTokenUrl": "https://authserver.example/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Enables an AISP to retrieve the account product information for a specific PSU account."
        },
        {
          "info": {
            "name": "Get Products",
