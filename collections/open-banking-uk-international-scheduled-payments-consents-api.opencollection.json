          "info": {
            "name": "Create an International Scheduled Payment Consent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/open-banking/v4.0/aisp/international-scheduled-payment-consents",
            "headers": [
              {
                "name": "x-fapi-auth-date",
                "value": ""
              },
              {
                "name": "x-fapi-customer-ip-address",
                "value": ""
              },
              {
                "name": "x-fapi-interaction-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "x-idempotency-key",
                "value": ""
              },
              {
                "name": "x-jws-signature",
                "value": ""
              },
              {
                "name": "x-customer-user-agent",
                "value": ""
              },
              {
                "name": "x-client-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://authserver.example/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Enables a PISP to register an intent to initiate an International Scheduled Payment."
